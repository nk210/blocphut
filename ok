<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Moi Choi Lien Quan</title>
<style>
  body{font-family:Segoe UI,Arial,sans-serif;background:#0d0d12;color:#fff;display:flex;justify-content:center;align-items:center;height:100vh;margin:0}
  .container{background:#16161f;border:1px solid #2c2c3a;border-radius:12px;padding:32px 36px;width:380px;text-align:center;box-shadow:0 4px 16px rgba(0,0,0,0.5)}
  h1{font-size:22px;font-weight:700;color:#f0c674;margin:0 0 8px}
  p{font-size:14px;color:#b0b0c0;margin:0 0 20px}
  .ign{background:#0f0f18;border:1px solid #333;border-radius:6px;padding:10px;font-size:15px;color:#fff;margin-bottom:24px}
  button{width:100%;padding:12px;margin:6px 0;border:none;border-radius:8px;font-size:15px;font-weight:600;cursor:pointer}
  .copy{background:#f0c674;color:#0d0d12}
  .share{background:transparent;color:#f0c674;border:1px solid #f0c674}
</style>
</head>
<body>
  <div class="container">
    <h1>MOI LEO RANK LIEN QUAN</h1>
    <p>Gui link tai game cho ban be</p>
    <div class="ign">IGN: KietPhuongNhi#2026</div>
    <button class="copy" onclick="copyLink()">Sao chep link tai game</button>
    <button class="share" onclick="shareLink()">Chia se qua Zalo</button>
  </div>
<script>
const gameLink="https://moba.garena.vn/vi/aov/";
function copyLink(){prompt("Nhan Ctrl+C de copy:",gameLink);}
function shareLink(){window.open("https://zalo.me/share?url="+encodeURIComponent(gameLink));}
</script>
</body>
</html>